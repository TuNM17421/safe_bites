DATABASE_URL="postgresql://safebite:safebite@localhost:5432/safebite?schema=public"
# Direct (non-pooled) connection for `prisma migrate` (ADR-008). Locally this equals
# DATABASE_URL; in production it is the Neon direct endpoint (DATABASE_URL is pooled).
DIRECT_URL="postgresql://safebite:safebite@localhost:5432/safebite?schema=public"
NEXT_PUBLIC_APP_NAME="SafeBite Travel"
NEXT_PUBLIC_DEFAULT_CITY="hanoi"
NEXT_PUBLIC_SUPPORTED_CITIES="hanoi,da_nang,hoi_an"
NEXT_PUBLIC_SUPPORTED_LANGUAGES="en,vi"
ADMIN_TOKEN="change-me-in-dev"
OFFLINE_CACHE_TTL_DAYS="7"
PWA_INSTALL_ENABLED="true"
# Optional. When set, the /agent chat and /ocr scanner use OpenAI (gpt-4o-mini): grounded chat +
# food-photo vision. Server-only — never expose as NEXT_PUBLIC. Absent ⇒ both fall back to their
# deterministic stubs and the app runs unchanged.
OPENAI_API_KEY=""
