{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "noEmit": true,
    "incremental": true,
    "allowJs": true,
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@safebite/domain": ["../../packages/domain/src/index.ts"],
      "@safebite/domain/*": ["../../packages/domain/src/*"]
    }
  },
  "include": ["next-env.d.ts", "src", "scripts", "prisma", ".next/types/**/*.ts"],
  "comment": "service-worker.ts targets the WebWorker lib (not DOM) and is compiled separately by @serwist/next.",
  "exclude": ["node_modules", "src/lib/service-worker.ts"]
}
